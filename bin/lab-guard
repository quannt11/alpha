#!/usr/bin/env python3
"""PreToolUse guard for lab agents. Exit 2 blocks the tool call (this works even
under --permission-mode bypassPermissions); stderr is shown to the agent.

It is a seatbelt, not a vault: agents run as the same Unix user as labd. What
it stops is the easy paths — reading credential files, dumping the environment,
pushing to the public repo, submitting to the live subnet, renting GPUs around
the budget, editing the control plane, or killing the daemon.
"""
import json
import os
import re
import shlex
import sys

HOME = os.path.expanduser("~")
LAB = os.path.join(HOME, "Work", "lab")
MAINTAINER = os.environ.get("LAB_ROLE") == "maintainer"

SECRET_PATH = re.compile(
    r"(\.local/state/lab/|\.config/lab/secrets|discord-reporter/\.env|\.claude/settings(\.local)?\.json|\.claude\.json|"
    r"\.claude/\.credentials|ralphs/secret\.sh|\.swarm_env|/proc/[^/\s]+/environ|\.ssh/(?!runpod_pic\b)[\w.-]*id_)")
SECRET_NAME = re.compile(r"(RUNPOD_API_KEY|SHADEFORM_API_KEY|DISCORD_BOT_TOKEN|CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)")
ENV_DUMP = re.compile(r"(^|[;&|(]\s*)(printenv|env|export\s+-p|set|declare\s+-x)\s*($|[;&|)>])")
CONTROL_PLANE = re.compile(
    re.escape(LAB) + r"/(lab/|bin/|lab\.toml|vendor/|projects/[^/\s]+/(project\.toml|plugin\.py))|"
    r"~/Work/lab/(lab/|bin/|lab\.toml|vendor/|projects/[^/\s]+/(project\.toml|plugin\.py))")
# the maintainer changes its own worktree; the live lab is merged into only by bin/lab-deploy
LIVE_LAB = re.compile(r"(" + re.escape(LAB) + r"|~/Work/lab|\$HOME/Work/lab)(?=[/\s'\"]|$)")
GIT_WRITES = {"commit", "merge", "reset", "checkout", "switch", "rebase", "revert", "cherry-pick", "stash", "tag",
              "branch", "worktree", "restore", "rm", "mv", "apply", "am", "clean", "pull", "fetch", "add", "update-ref"}
WRITE_OP = re.compile(r"(sed\s+-i|\btee\b|>|\bmv\b|\bcp\b|\brm\b|\bchmod\b|\btruncate\b|\binstall\b|\bln\b)")

BASH_RULES = [
    (re.compile(r"submit\.py\b.*\b(submit|upload|ready|register|activate|auth)\b|\bbtcli\b.*\b(register|transfer|stake|set)\b"),
     "submitting to or registering on the live subnet needs a human. Prepare the candidate and ask in Discord."),
    (re.compile(r"runpodctl|rest\.runpod\.io|api\.runpod\.io|api\.shadeform\.ai|platform\.shadeform\.ai"), "GPUs are rented only through `lab gpu lease` (budget-enforced)."),
    (re.compile(r"\blab\s+gpu\s+(resume|pause)\b|\bLAB_RUN_ID=|\bunset\s+LAB_RUN_ID\b|env\s+-u\s*LAB_RUN_ID"),
     "pausing/resuming GPUs is a human decision."),
    (re.compile(r"\blab\s+maint\s+(request|approve|reject|mark)\b|\blab-deploy\b|\bsystemd-run\b"),
     "changing and deploying the lab's own code is for operators."),
    (re.compile(r"(systemctl\b.*\blabd\b|\bpkill\b.*\blab|\bkillall\b.*\blab|kill\b.*\$\(pgrep[^)]*lab)"),
     "the control plane is not yours to stop or restart."),
    (re.compile(r"\brm\s+-[A-Za-z]*r[A-Za-z]*\s+(/|~|\$HOME|/home/[^/\s]+)/?(\s|$)"), "refusing to delete a home or root directory."),
    (re.compile(r"\bmkfs\b|\bdd\b[^|;]*\bof=/dev/"), "refusing to touch block devices."),
    (re.compile(r"\.local/state/lab|\blab\.db\b|\bsqlite3?\b.*\blab\b"),
     "the lab's database is changed only through the `lab` CLI."),
]


GIT_OPT_WITH_ARG = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"}


def git_subcommands(cmd: str):
    """Yield the subcommand of every `git …` invocation (skipping global options)."""
    for seg in re.split(r"[;&|\n()]+", cmd):
        try:
            toks = shlex.split(seg)
        except ValueError:
            toks = seg.split()
        for i, t in enumerate(toks):
            if os.path.basename(t) != "git":
                continue
            j = i + 1
            while j < len(toks):
                if toks[j] in GIT_OPT_WITH_ARG:
                    j += 2
                elif toks[j].startswith("-"):
                    j += 1
                else:
                    yield toks[j]
                    break


def block(msg: str):
    print(f"lab-guard: blocked — {msg}", file=sys.stderr)
    sys.exit(2)


def main():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    tool = ev.get("tool_name", "")
    inp = ev.get("tool_input") or {}
    if tool == "Bash":
        cmd = inp.get("command", "")
        if SECRET_PATH.search(cmd):
            block("that path holds credentials.")
        if SECRET_NAME.search(cmd):
            block("credential variables are not available to agents.")
        if ENV_DUMP.search(cmd):
            block("dumping the environment is not allowed.")
        if "push" in git_subcommands(cmd):
            block("agents do not push. Commit locally; a human pushes (the affine repo's origin is public).")
        for rx, msg in BASH_RULES:
            if rx.search(cmd):
                block(msg)
        if CONTROL_PLANE.search(cmd) and WRITE_OP.search(cmd):
            block("the lab control plane (lab/, bin/, lab.toml, project.toml, plugin.py) is read-only for agents.")
        if MAINTAINER and LIVE_LAB.search(cmd) and (WRITE_OP.search(cmd) or GIT_WRITES & set(git_subcommands(cmd))):
            block("the live lab is read-only for you: change and commit in your worktree (your cwd); "
                  "labd deploys it.")
        return
    paths = [inp.get(k) for k in ("file_path", "path", "notebook_path") if inp.get(k)]
    if tool in ("Grep", "Glob") and inp.get("pattern"):
        paths.append(inp["pattern"])
    for pth in paths:
        full = os.path.realpath(os.path.expanduser(str(pth)))
        if SECRET_PATH.search(full) or SECRET_PATH.search(str(pth)):
            block("that path holds credentials.")
        if tool in ("Edit", "Write", "NotebookEdit", "MultiEdit") and CONTROL_PLANE.search(full):
            block("the lab control plane is read-only for agents.")
        if MAINTAINER and tool in ("Edit", "Write", "NotebookEdit", "MultiEdit") and (full + "/").startswith(LAB + "/"):
            block("the live lab is read-only for you: edit the copy in your worktree (your cwd).")


if __name__ == "__main__":
    main()
